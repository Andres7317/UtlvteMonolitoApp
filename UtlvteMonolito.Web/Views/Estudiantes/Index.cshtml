@model IEnumerable<UtlvteMonolito.Web.Models.Estudiante>

@{
    ViewData["Title"] = "Gestión de Estudiantes - UTLVTE";
}

<div class="container mt-4">
    <!-- Encabezado y Botón Crear -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-people-fill"></i> Listado de Estudiantes Registrados</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Estudiante
        </a>
    </div>

    <!-- Mensaje de confirmación emergente (Crear, Editar, Eliminar) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla con diseño Bootstrap -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Cédula</th>
                            <th>Nombres</th>
                            <th>Apellidos</th>
                            <th>Correo Institucional</th>
                            <th>Carrera</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No hay estudiantes registrados actualmente.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Cedula</td>
                                    <td>@item.Nombres</td>
                                    <td>@item.Apellidos</td>
                                    <td>
                                        <a href="mailto:@item.CorreoInstitucional" class="text-decoration-none">
                                            @item.CorreoInstitucional
                                        </a>
                                    </td>
                                    <td><span class="badge bg-info text-dark">@item.Carrera</span></td>
                                    <td>
                                        @if (item.EstadoActivo)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Inactivo</span>
                                        }
                                    </td>
                                    <!-- Botones de Acción CRUD -->
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar Estudiante">
                                                <i class="bi bi-pencil-square"></i> Editar
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Ver Detalles">
                                                <i class="bi bi-eye-fill"></i> Detalles
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar Estudiante">
                                                <i class="bi bi-trash-fill"></i> Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>